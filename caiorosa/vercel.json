{
  "routes": [
    {
      "src": "/(img|fonts|audio|og)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/(.*/)?(index|site)\\.html",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/((?:en/)?(?:rios-falam-rios-cantam|for-sale|visoes-do-luvemba|europe-is-not-my-center|biografia|publicacoes|som|videos|textos|contato))/",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/en",
      "status": 308,
      "headers": {
        "Location": "/en/"
      }
    },
    {
      "src": "/",
      "dest": "/site.html"
    },
    {
      "src": "/en/",
      "dest": "/en/site.html"
    },
    {
      "src": "/(rios-falam-rios-cantam|for-sale|visoes-do-luvemba|europe-is-not-my-center|biografia|publicacoes|som|videos|textos|contato)",
      "dest": "/$1/site.html"
    },
    {
      "src": "/en/(rios-falam-rios-cantam|for-sale|visoes-do-luvemba|europe-is-not-my-center|biografia|publicacoes|som|videos|textos|contato)",
      "dest": "/en/$1/site.html"
    }
  ]
}