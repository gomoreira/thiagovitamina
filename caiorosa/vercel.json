{
  "routes": [
    {
      "src": "/(img|fonts|audio|og)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()",
        "Content-Security-Policy": "default-src 'self'; img-src 'self' data: https://i.ytimg.com; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
      },
      "continue": true
    },
    {
      "src": "/(.*/)?(index|site)\\.html",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/((?:en/)?(?:rios-falam-rios-cantam|for-sale|visoes-do-luvemba|europe-is-not-my-center|biografia|publicacoes|som|videos|textos|contato))/",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/en",
      "status": 308,
      "headers": {
        "Location": "/en/"
      }
    },
    {
      "src": "/",
      "dest": "/site.html"
    },
    {
      "src": "/en/",
      "dest": "/en/site.html"
    },
    {
      "src": "/(rios-falam-rios-cantam|for-sale|visoes-do-luvemba|europe-is-not-my-center|biografia|publicacoes|som|videos|textos|contato)",
      "dest": "/$1/site.html"
    },
    {
      "src": "/en/(rios-falam-rios-cantam|for-sale|visoes-do-luvemba|europe-is-not-my-center|biografia|publicacoes|som|videos|textos|contato)",
      "dest": "/en/$1/site.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}