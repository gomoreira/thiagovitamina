{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/site.html"
    },
    {
      "source": "/en",
      "destination": "/en/site.html"
    },
    {
      "source": "/en/",
      "destination": "/en/site.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(img|fonts|audio)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}